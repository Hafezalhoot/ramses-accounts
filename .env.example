# Copy using: python3 scripts/setup_local.py
# This is read by Docker Compose; NEVER commit/share the generated .env file.
RAMSES_ADMIN_USER=owner
RAMSES_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
RAMSES_ENVIRONMENT=staging
# Owner-only Google Sheets mirror. Enable only after a service account is set up:
# GOOGLE_SHEET_ID=1BIjVrtYUlt8lOtaarZPyz4Cci0XIp5eWIJwOCfUfTTk
# GOOGLE_SERVICE_ACCOUNT_JSON=/secrets/service-account.json

# Enable only after evidence workflow validation: enforce an attachment before any PAYMENT approval.
RAMSES_REQUIRE_PAYMENT_EVIDENCE=0
